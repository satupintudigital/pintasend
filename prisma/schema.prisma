generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String   @id @default(uuid(7))
  name             String
  nalaniagaStoreId String?  @unique
  createdAt        DateTime @default(now())
  users            User[]
  devices          Device[]
}

model User {
  id           String   @id @default(uuid(7))
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("owner") // "owner" | "member"
  createdAt    DateTime @default(now())
}

model Device {
  id              String   @id @default(uuid(7))
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label           String
  openwaSessionId String   @unique
  phone           String?
  status          String   @default("created")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())
}

model ApiKey {
  id         String    @id @default(uuid(7))
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label      String
  keyHash    String // SHA-256 dari key mentah (tidak pernah simpan key mentah)
  prefix     String // tampilan aman, mis. wavio_8f3a…
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}
