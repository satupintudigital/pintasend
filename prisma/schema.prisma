generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String   @id @default(uuid(7))
  name             String
  nalaniagaStoreId String?  @unique
  createdAt        DateTime @default(now())
  users            User[]
  devices          Device[]
  messages         MessageLog[]
}

model User {
  id           String   @id @default(uuid(7))
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("owner") // "owner" | "member"
  createdAt    DateTime @default(now())
}

model Device {
  id                String   @id @default(uuid(7))
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label             String
  openwaSessionId   String   @unique
  openwaWebhookId   String? // ID registrasi webhook di OpenWA (untuk unregister)
  phone             String?
  status            String   @default("created")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt @default(now())
}

model Webhook {
  id        String   @id @default(uuid(7))
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String // URL endpoint milik client yang menerima event
  secret    String // HMAC secret utk menandatangani delivery (x-wavio-signature)
  events    String   @default("[\"message.received\",\"session.status\"]") // JSON array event
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model MessageLog {
  id          String   @id @default(uuid(7))
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId    String?
  deviceLabel String?
  direction   String // "incoming" | "outgoing"
  chatId      String // "62812…@c.us"
  body        String   @default("")
  type        String? // text, image, video, …
  status      String? // sent, delivered, failed, …
  messageId   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
}

model ApiKey {
  id         String    @id @default(uuid(7))
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label      String
  keyHash    String // SHA-256 dari key mentah (tidak pernah simpan key mentah)
  prefix     String // tampilan aman, mis. wavio_8f3a…
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}
