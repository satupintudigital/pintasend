generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String   @id @default(uuid(7))
  name             String
  nalaniagaStoreId String?  @unique
  createdAt        DateTime @default(now())
  users            User[]
  devices          Device[]
}

model User {
  id           String   @id @default(uuid(7))
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("owner") // "owner" | "member"
  createdAt    DateTime @default(now())
}

model Device {
  id              String   @id @default(uuid(7))
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label           String
  openwaSessionId String   @unique
  phone           String?
  status          String   @default("created")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
