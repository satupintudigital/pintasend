generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id                  String   @id @default(uuid(7))
  name                String
  tagline             String
  priceDisplay        String
  priceMonthly        Int? // nominal rupiah/bulan (null = gratis / tidak tertera)
  kind                String   @default("subscription") // subscription | prepaid (Espresso)
  isPublic            Boolean  @default(true) // tampil di katalog publik (halaman harga)
  sortOrder           Int      @default(0) // urutan tampil katalog
  maxDevices          Int
  maxUsers            Int
  maxMessagesPerMonth Int?
  includesDelay       Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  tenants             Tenant[]
  orders              Order[]
}

// ─── INVOICE (registri tagihan bulanan, simulasi) ───────────────────────────
// Belum terhubung payment gateway — dokumentasikan sebagai registri tagihan
// agar platform admin punya gambaran pendapatan per bulan. periodStart unik per
// tenant (satu invoice per tenant per bulan). priceMonthly = snapshot nominal
// plan saat invoice terbit (ubah harga plan tidak mengubah invoice lama).

model Invoice {
  id           String   @id @default(uuid(7))
  tenantId     String
  planId       String?
  planName     String
  priceMonthly Int? // snapshot nominal saat terbit (Rp)
  periodStart  DateTime // awal bulan tagihan (WIB)
  periodEnd    DateTime // akhir bulan tagihan (WIB)
  status       String   @default("issued") // issued | paid | void
  paidAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  @@unique([tenantId, periodStart])
  @@index([status, periodStart])
}

model Tenant {
  id                   String   @id @default(uuid(7))
  name                 String
  nalaniagaStoreId     String?  @unique
  planId               String?
  plan                 Plan?    @relation(fields: [planId], references: [id])
  planAssignedAt       DateTime?
  planPeriodEnd        DateTime? // akhir periode berlangganan berjalan (WIB)
  activatedAt          DateTime? // null = tenant pending (belum bayar order pertama)
  suspendedAt          DateTime?
  delayEnabled         Boolean  @default(false)
  messageRetentionDays Int      @default(30) // retensi pesan efektif (hari); >30 hanya via RetentionRequest approved
  createdAt            DateTime @default(now())
  users                User[]
  devices              Device[]
  messages             MessageLog[]
  addons               TenantAddon[]
  balance              TenantBalance?
  creditLedger         CreditLedger[]
  orders               Order[]
  retentionRequests    RetentionRequest[]
  contacts             Contact[]
  campaigns            Campaign[]
  webhooks             Webhook[]
  webhookDeliveries           WebhookDelivery[]
  apiKeys                     ApiKey[]
  whatsappTemplates           TenantWhatsAppTemplate[]
  labels                      Label[]
}

// ─── TENANT WHATSAPP TEMPLATE SYNC ──────────────────────────────────────────

model TenantWhatsAppTemplate {
  id             String   @id @default(uuid(7))
  tenantId       String
  nalaniagaStoreId String
  event          String
  canonicalName  String
  header         String?
  body           String
  footer         String?
  version        Int      @default(1)
  checksum       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt @default(now())

  tenant   Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  devices  TenantWhatsAppTemplateDevice[]
  jobs     TenantWhatsAppTemplateSyncJob[]

  @@unique([tenantId, event])
  @@index([nalaniagaStoreId, event])
  @@index([tenantId, isActive])
}

model TenantWhatsAppTemplateDevice {
  id                  String   @id @default(uuid(7))
  tenantId            String
  deviceId            String
  templateId          String
  physicalTemplateName String
  physicalTemplateId  String?
  canonicalVersion    Int
  checksum            String
  status              String   @default("pending")
  attempts            Int      @default(0)
  nextAttemptAt       DateTime @default(now())
  lastError           String?
  syncedAt            DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt @default(now())

  device   Device                 @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  template TenantWhatsAppTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([deviceId, templateId])
  @@index([tenantId, status, nextAttemptAt])
  @@index([templateId, canonicalVersion])
}

model TenantWhatsAppTemplateSyncJob {
  id               String   @id @default(uuid(7))
  tenantId         String
  templateId       String
  deviceId         String
  canonicalVersion Int
  checksum         String
  status           String   @default("pending")
  attempts         Int      @default(0)
  nextAttemptAt    DateTime @default(now())
  lastError        String?
  lockedAt         DateTime?
  syncedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt @default(now())

  template TenantWhatsAppTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  device   Device                 @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, templateId, canonicalVersion, checksum])
  @@index([status, nextAttemptAt])
  @@index([tenantId, deviceId, status])
}

// Instruksi tertulis perpanjangan retensi dari tenant (DPA §5.7).
// "requestedBy" = pemohon pihak tenant; status pending → approved/rejected
// oleh platform admin (approvedBy/approvedAt) — bukti dasar hukum perpanjangan.
model RetentionRequest {
  id             String    @id @default(uuid(7))
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy    String
  reason         String
  retentionDays  Int
  status         String    @default("pending") // pending | approved | rejected
  approvedBy     String?
  approvedAt     DateTime?
  rejectedBy     String?
  rejectedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt @default(now())

  @@index([tenantId, status])
  @@index([status])
}

model TenantAddon {
  id          String    @id @default(uuid(7))
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  active      Boolean   @default(true)
  activeUntil DateTime? // null = permanen (grant manual); timestamp = kedaluwarsa (addon mandiri)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())

  @@unique([tenantId, key])
}

// ─── SELF-SERVE BILLING ─────────────────────────────────────────────────────
// Order = instrumen pembayaran (snapshot item, merchant_ref Tripay = order.id).
// Invoice tetap registri tagihan bulanan; order renewal menaut ke invoice.
// TenantBalance + CreditLedger = pulsa pesan prepaid (Espresso).

model Addon {
  id           String   @id @default(uuid(7))
  key          String   @unique // addonKey dari src/lib/addonKeys (single source)
  name         String
  tagline      String   @default("")
  priceMonthly Int? // null = tidak dijual mandiri (grant manual platform)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())
}

model Order {
  id            String    @id @default(uuid(7))
  tenantId      String
  userId        String
  kind          String // first_subscription | renewal_subscription | addon | topup
  status        String    @default("pending") // pending | paid | expired | cancelled
  invoiceId     String?
  planId        String?
  addonKey      String?
  amount        Int
  itemsJson     String // JSON OrderItem[]
  periodStart   DateTime?
  periodEnd     DateTime?
  creditMessages Int?
  gateway       String    @default("tripay")
  gatewayRef    String?
  payCode       String?
  checkoutUrl   String?
  payMethod     String?
  expiresAt     DateTime?
  paidAt        DateTime?
  callbackRaw   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan?  @relation(fields: [planId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@index([invoiceId])
}

model TenantBalance {
  tenantId  String   @id
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  balance   Int      @default(0) // sisa pulsa pesan prepaid
  updatedAt DateTime @updatedAt @default(now())
}

model CreditLedger {
  id        String   @id @default(uuid(7))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String?
  delta     Int // + topup, - pemakaian
  reason    String // topup | send
  refId     String? // unik idempoten (orderId utk topup, messageId utk send)
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@unique([refId])
}

model User {
  id           String   @id @default(uuid(7))
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("owner") // "member" | "tenant_admin" | "owner" | "platform_admin" (string; validasi di src/lib/abac.ts & authStore)
  createdAt    DateTime @default(now())
}

model Device {
  id                String   @id @default(uuid(7))
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label             String
  openwaSessionId   String   @unique
  openwaWebhookId   String? // ID registrasi webhook di OpenWA (untuk unregister)
  phone             String?
  restriction       String? // JSON { kind, code, expiresAt } (session.restriction)
  status            String   @default("created")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt @default(now())
  templateBindings  TenantWhatsAppTemplateDevice[]
  templateSyncJobs  TenantWhatsAppTemplateSyncJob[]
}

model Webhook {
  id        String   @id @default(uuid(7))
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String // URL endpoint milik client yang menerima event
  secret    String // HMAC secret utk menandatangani delivery (x-pintasend-signature)
  events    String   @default("[\"message.received\",\"session.status\"]") // JSON array event
  filters   String   @default("{\"conditions\":[]}") // JSON smart filters (lihat src/lib/webhookFilters.ts)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  deliveries WebhookDelivery[]
}

// Outbox delivery webhook (pola outbox — lihat src/lib/webhookDelivery.ts).
// Ingest menulis baris pending, mencoba deliver sekali; worker cron mengambil
// alih retry (backoff 30s/5m) sampai DELIVERY_MAX_ATTEMPTS → dead-letter.
// Hanya Neon (bukan D1) — jalur frekuensi rendah, konsisten dgn MessageLog.
model WebhookDelivery {
  id            String   @id @default(uuid(7))
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookId     String
  webhook       Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event         String
  url           String // snapshot URL client saat enqueue
  payload       String // envelope JSON mentah (body yg dikirim)
  signature     String // x-pintasend-signature atas payload
  status        String   @default("pending") // pending | delivered | failed
  attempts      Int      @default(0)
  nextAttemptAt DateTime? // kapan boleh dicoba lagi (null = segera)
  lastError     String?
  lastAttemptAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now())

  @@index([tenantId, status])
  @@index([status, nextAttemptAt])
}

model MessageLog {
  id          String   @id @default(uuid(7))
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId    String?
  deviceLabel String?
  direction   String // "incoming" | "outgoing"
  chatId      String // "62812…@c.us"
  body        String   @default("")
  type        String? // text, image, video, document, …
  status      String? // sent, delivered, failed, …
  messageId   String?
  mediaUrl    String? // URL media (outgoing URL mode); null utk base64/multipart/incoming
  mimetype    String? // application/pdf, image/jpeg, …
  mediaKey    String? // R2 object key (upload multipart); null utk lainnya
  triggeredAt DateTime? // waktu trigger kirim (sebelum delay) — pesan keluar
  sentAt      DateTime? // waktu kirim ke OpenWA (setelah delay) — pesan keluar
  reaction    String? // JSON map senderId → emoji (message.reaction)
  watermark   Boolean  @default(false) // true = footnote iklan platform disisipkan
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
}

model ApiKey {
  id         String    @id @default(uuid(7))
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label      String
  keyHash    String // SHA-256 dari key mentah (tidak pernah simpan key mentah)
  prefix     String // tampilan aman, mis. pintasend_8f3a…
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

// ─── AUDIT LOG (lintas-tenant, platform admin) ──────────────────────────────
// Jejak aksi admin & mutasi kunci (tenant.suspend, user.role.update, addon.set,
// apikey.create/revoke, retention.approve, …). Hanya Neon — jalur admin
// frekuensi rendah; TIDAK di-clone ke D1 (konsisten ADR-9). actorEmail wajib;
// tenantId null = aksi platform-wide. meta = JSON objek detail.

model AuditLog {
  id          String   @id @default(uuid(7))
  tenantId    String?
  actorUserId String?
  actorEmail  String
  actorRole   String
  action      String // tenant.suspend | tenant.activate | user.create | apikey.revoke | …
  targetType  String? // "tenant" | "user" | "device" | "apikey" | "webhook" | …
  targetId    String?
  meta        String   @default("{}") // JSON objek (before/after, detail)
  ip          String?
  createdAt   DateTime @default(now())

  @@index([action, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorEmail, createdAt(sort: Desc)])
}

// Kontak audiens campaign (per tenant). `chatId` JID WhatsApp; opt-out
// dihormati dispatcher (recipient dengan kontak optedOut → status skipped).
// ─── PLATFORM SETTING (key-value global, platform admin) ────────────────────
// Nilai disimpan sebagai JSON string (string/bool/int sesuai key whitelist di
// src/lib/platformSettings.ts). Hanya Neon — dibaca jalur frekuensi rendah
// (watermark footnote, nama platform) dengan cache per-proses.
model PlatformSetting {
  key       String   @id
  value     String // JSON (string/bool/int sesuai key)
  updatedBy String?
  updatedAt DateTime @updatedAt @default(now())
}

// ─── PLATFORM BROADCAST (pengumuman platform → nomor owner device) ──────────
// Scope terpisah dari campaign tenant: broadcast dikirim ke `Device.phone`
// (nomor pemilik perangkat yang siap), bukan ke kontak tenant. Dispatcher
// (Task 11) mem-klaim job pending → kirim text via openwa → MessageLog tenant.

model PlatformBroadcast {
  id          String   @id @default(uuid(7))
  name        String
  messageBody String
  status      String   @default("draft") // draft | running | completed | failed | cancelled
  targetMode  String   @default("ready_devices") // ready_devices | tenant_ids
  tenantIds   String   @default("[]") // JSON array — filter bila targetMode=tenant_ids
  createdBy   String? // actor email
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  failReason  String?
  totalJobs   Int      @default(0)
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
  jobs        PlatformBroadcastJob[]
}

model PlatformBroadcastJob {
  id            String   @id @default(uuid(7))
  broadcastId   String
  tenantId      String
  deviceId      String
  deviceLabel   String?
  chatId        String? // tujuan (phone@c.us dari device) — diset saat dispatch
  status        String   @default("pending") // pending | sending | sent | failed | skipped
  error         String?
  messageId     String?
  attempts      Int      @default(0)
  nextAttemptAt DateTime? // backoff retry
  lockedAt      DateTime? // klaim dispatcher (staleness recovery)
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now())
  broadcast     PlatformBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId, status])
  @@index([status, nextAttemptAt])
}

// Kontak audiens campaign (per tenant). `chatId` JID WhatsApp; opt-out
// dihormati dispatcher (recipient dengan kontak optedOut → status skipped).
model Contact {
  id        String   @id @default(uuid(7))
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chatId    String // "62812…@c.us"
  name      String?
  tags      String   @default("[]") // JSON array of strings — filter audiens campaign
  optedOut  Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@unique([tenantId, chatId])
  @@index([tenantId, optedOut])
}

// Campaign blast pesan massal. Template body mendukung variabel {{nama}} dll.
// Status: draft → scheduled/running → paused → completed | failed | cancelled.
// Dispatch dilakukan worker cron (workers/campaign-dispatch) — bukan request
// Workers (batas eksekusi), pola antrean sama dengan WebhookDelivery.
model Campaign {
  id              String    @id @default(uuid(7))
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId        String?
  deviceLabel     String? // snapshot label saat start (device bisa terhapus belakangan)
  name            String
  status          String    @default("draft") // draft|scheduled|running|paused|completed|failed|cancelled
  messageBody     String // template teks; juga dipakai sebagai caption media
  mediaType       String? // image|video|audio|document (null = text saja)
  mediaUrl        String?
  filename        String?
  audienceTag     String? // null = semua kontak non opt-out; else filter tag
  minDelaySec     Int       @default(5) // jeda minimum antar pesan (detik)
  maxDelaySec     Int       @default(15) // jeda maksimum (acak di antara keduanya)
  scheduledAt     DateTime? // null = mulai segera saat start
  startedAt       DateTime?
  completedAt     DateTime?
  failReason      String?
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  skippedCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt @default(now())

  recipients       CampaignRecipient[]

  @@index([tenantId, status])
  @@index([status, scheduledAt])
}

// Baris penerima campaign — unit kerja dispatcher. Snapshot nama & chatId agar
// perubahan/penghapusan kontak tidak mengubah riwayat campaign berjalan.
model CampaignRecipient {
  id         String    @id @default(uuid(7))
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String?
  chatId     String
  name       String?
  status     String    @default("pending") // pending|sending|sent|failed|skipped ('sending' = diklaim dispatcher, recovery >10 menit → pending)
  error      String?
  messageId  String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt @default(now()) // staleness claim dispatcher (recovery >10 menit)

  @@index([campaignId, status])
}

// ─── LABELS (PintaSend-local + OpenWA sync) ───────────────────────────────────
// Label lokal untuk CRM/campaign filtering + sinkronisasi optional ke
// OpenWA labels (visible di WhatsApp dashboard).
// Dual-layer: PintaSend = source of truth untuk nama/warna;
//             OpenWA = source of truth untuk label-chat association.

model Label {
  id              String   @id @default(uuid(7))
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  color           String   @default("#6366f1") // hex color untuk dashboard
  openwaLabelId   String?  // synced OpenWA label ID (null = local-only)
  openwaSyncedAt  DateTime? // timestamp sync terakhir
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())

  contacts        LabelContact[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model LabelContact {
  id          String   @id @default(uuid(7))
  tenantId    String
  labelId     String
  label       Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  chatId      String   // JID: "62812...@c.us"
  createdAt   DateTime @default(now())

  @@unique([labelId, chatId])
  @@index([tenantId, chatId])
  @@index([labelId])
}
