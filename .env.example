# Neon Postgres (serverless) — pakai driver adapter, wajib di Cloudflare Workers
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-1234567890.ap-southeast-1.aws.neon.tech/wavio?sslmode=require"

# Auth.js v5 (wajib, minimal 32 karakter, acak)
AUTH_SECRET="<random-32-char>"

# OpenWA backend — via Cloudflare Tunnel (https), karena Worker tak bisa
# fetch IP mentah (error 1003). Contoh: https://owa.nalaniaga.id
OPENWA_BASE_URL="https://owa.nalaniaga.id"
OPENWA_ADMIN_KEY="owa_k1_..."

# Turnstile — sitekey publik (aman di-bundle), URL managed siteverify worker.
NEXT_PUBLIC_TURNSTILE_SITEKEY="0x4AAAAAAESpUhXE0d_l2Z_l"
NEXT_PUBLIC_TURNSTILE_SITEVERIFY_URL="https://turnstile-siteverify-wavio.xolution.workers.dev"
OPENWA_WEBHOOK_SECRET="wavio-wh-secret-ganti-ini"

# Resend — transactional email. Ganti "re_xxxxxxxxx" dengan API key aslimu
# (https://resend.com/api-keys).
RESEND_API_KEY="re_xxxxxxxxx"

# Email — default pengirim bila `from` tidak dikirim di body API /api/email.
# Harus dari domain yang sudah diverifikasi di Resend.
EMAIL_FROM="Wavio <noreply@wavio.satupintudigital.co.id>"

# PostHog — Product analytics, session replay, error tracking
# Ambil dari: https://app.posthog.com/settings/project#keys
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ═══════════════════════════════════════════════════════════
# 🔄 NALANIAGA TEMPLATE SYNC
# ═══════════════════════════════════════════════════════════
# Secret service-to-service untuk POST /internal/nalaniaga/template-sync.
# Harus sama dengan WAVIO_TEMPLATE_SYNC_SECRET di NalaNiaga.
# Jangan expose ke browser atau memakai NEXT_PUBLIC_.
WAVIO_TEMPLATE_SYNC_SECRET="ganti-dengan-secret-sync-random"

# Secret untuk manual trigger worker template-sync (POST ...?token=...).
# Set sebagai secret Cloudflare Worker, bukan vars publik.
TEMPLATE_SYNC_TOKEN="ganti-dengan-worker-token-random"

# Worker template-sync memakai secret berikut:
#   DATABASE_URL, OPENWA_ADMIN_KEY, TEMPLATE_SYNC_TOKEN
# Contoh setup dari direktori wavio:
#   npx wrangler secret put DATABASE_URL --config workers/template-sync/wrangler.jsonc
#   npx wrangler secret put OPENWA_ADMIN_KEY --config workers/template-sync/wrangler.jsonc
#   npx wrangler secret put TEMPLATE_SYNC_TOKEN --config workers/template-sync/wrangler.jsonc
# OPENWA_BASE_URL dapat diisi sebagai vars pada config worker.
